{
  "name": "@socialchamp/n8n-nodes-socialchamp",
  "version": "0.1.0",
  "description": "n8n community node for Social Champ - list channels and create or schedule posts.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "socialchamp",
    "social-media",
    "scheduling"
  ],
  "license": "MIT",
  "homepage": "https://developers.socialchamp.com",
  "author": {
    "name": "Social Champ",
    "email": "support@socialchamp.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SocialChamp/socialchamp-n8n.git"
  },
  "engines": {
    "node": ">=22.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SocialChampApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SocialChamp/SocialChamp.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.43.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
