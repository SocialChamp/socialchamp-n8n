nodes
credentials
*.ts
tsconfig.json
tsconfig.test.json
tsconfig.tsbuildinfo
dist/tsconfig.tsbuildinfo
eslint.config.mjs
.prettierrc.js
jest.config.js
**/__tests__
.gitattributes
