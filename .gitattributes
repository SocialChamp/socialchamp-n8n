# Normalise line endings so a Windows checkout does not rewrite every file.
# Text is stored as LF in the repository and checked out as-is.
* text=auto eol=lf

# Binary and image assets must never be touched.
*.png binary
*.jpg binary
*.ico binary

# SVGs are text, but keeping them LF avoids noisy icon diffs.
*.svg text eol=lf

# Generated - keep out of diffs and language stats.
package-lock.json linguist-generated=true
