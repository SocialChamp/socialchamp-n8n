{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// Leave the build info inside outDir. `n8n-node build` wipes dist/ before
		// each build, so keeping it there means the cache dies with the output.
		// Parked anywhere else it survives the clean and tsc then "successfully"
		// emits nothing, leaving a dist/ that is missing most of the package.
		"incremental": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/",
		"types": ["node", "jest"]
	},
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json", "package.json"],
	"comment": "Tests type-check through ts-jest, but must never reach dist/ - the published package ships runtime files only.",
	"exclude": ["**/__tests__/**", "dist", "node_modules"]
}
